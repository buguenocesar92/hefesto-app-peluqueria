# =============================================================================
# Hefesto Studio — Peluquería: variables del despliegue
# =============================================================================
# Este archivo lo lee `deploy/docker-compose.prod.yml` para saber a qué dominio
# serving el proxy y con qué correo pide el certificado.
#
# NO es el archivo de la API. Ese es `api/.env`, y ahí viven la base de datos,
# la conexión de auditoría, Redis y Authentik.
#
# Copie este archivo a `.env` y complete los valores. NUNCA versione `.env` con
# valores reales.
# =============================================================================

# -----------------------------------------------------------------------------
# Dominio
# -----------------------------------------------------------------------------
# Dominio por el que se entra a la aplicación. Tiene que resolver al servidor
# donde corre el compose, y en producción tiene que tener TLS válido: el ingreso
# manda la sesión por el navegador y no viaja por HTTP plano.
DOMINIO=peluqueria.ejemplo.cl

# Correo al que Caddy avisa si el certificado está por vencer o si hay un
# problema con el dominio. Es el correo del operador de la instalación, no del
# dueño del salón.
ACME_EMAIL=admin@hefesto.cl

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Estos valores tienen que COINCIDIR con los de `api/.env`. Si no coinciden,
# PostgreSQL crea una base con un nombre y la API busca otra, y el síntoma es un
# contenedor sano que responde "no existe la tabla".
#
# La contraseña va también en `api/.env`. Es el mismo valor en los dos archivos
# porque el compose crea el contenedor de PostgreSQL con él.
DB_DATABASE=peluqueria
DB_USERNAME=peluqueria
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# -----------------------------------------------------------------------------
# `DB_USERNAME` de arriba es el rol de la APLICACION, y lo crea
# `deploy/postgres/inicializar-rol.sh`. Este es el rol de ARRANQUE: la imagen
# oficial lo crea superusuario, y con superusuario PostgreSQL ignora las
# políticas de Row Level Security, así que la aplicación NUNCA entra con él.
#
# Su contraseña NO va en `api/.env`: la aplicación no conecta con este rol, así
# que no tiene por qué conocerla. Solo la lee el compose.
DB_ADMIN_USERNAME=peluqueria_admin
DB_ADMIN_PASSWORD=