# =============================================================================
# Hefesto Studio — Peluquería: API (Laravel)
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# NUNCA versione el `.env` con valores reales.
# =============================================================================

APP_NAME="Peluquería"
# `local` en desarrollo, `production` en producción.
APP_ENV=local
# En producción tiene que ser `false`: el registro con nivel `debug` puede
# incluir datos de una petición, y en un salón eso incluye la descripción de una
# atención con información de salud de la clienta.
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost:8000

APP_KEY=
# Genere la clave con: php artisan key:generate

LOG_CHANNEL=stack
LOG_STACK=single,stderr
# `debug` deja el cuerpo de las peticiones en el registro. Con datos de salud,
# en producción tiene que ser `info` o más alto.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# PostgreSQL, obligatorio. La Row Level Security no existe en otro motor, y el
# aislamiento entre salones depende de ella. Ver docs/03.
#
# El rol de la aplicación NO puede ser superusuario ni tener BYPASSRLS: con
# cualquiera de los dos, PostgreSQL ignora las políticas. Ver docs/03.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=peluqueria
DB_USERNAME=peluqueria
DB_PASSWORD=
# `prefer` sirve dentro de la red de Compose. Si la base queda afuera de la
# instalación, use `require` y revise la cadena de conexión. Ver docs/04.
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# -----------------------------------------------------------------------------
# El rol de arriba es el de la APLICACIÓN, y lo crea
# `deploy/postgres/inicializar-rol.sh` con NOSUPERUSER y NOBYPASSRLS explícitos.
# Hay además un rol de ARRANQUE, que la imagen oficial crea superusuario y con el
# que la aplicación NUNCA conecta: con superusuario, PostgreSQL ignora las
# políticas y el `FORCE ROW LEVEL SECURITY` no lo sujeta a él.
#
# Ese rol NO se declara acá: la aplicación no lo usa. Vive en el `.env` del
# despliegue, que es lo único que lee el compose. Ver docs/03.

# -----------------------------------------------------------------------------
# Conexión de la bitácora de accesos a los antecedentes de salud
# -----------------------------------------------------------------------------
# Aparte a propósito: la petición a la que se le deniega el acceso termina
# revertida, y el registro del intento tiene que sobrevivir a esa reversa. Ver
# App\Services\Tenancy\AuditorDeAcceso.
# Puede apuntar a otra base de datos, incluso a otra máquina.
DB_AUDITORIA_HOST=postgres
DB_AUDITORIA_PORT=5432
DB_AUDITORIA_DATABASE=peluqueria
# Tiene que ser IGUAL a `DB_USERNAME`: mientras lo sea, es el mismo rol y el
# script de arranque no crea nada extra. Si se cambia por otro rol, hay que
# poner TAMBIEN `DB_AUDITORIA_PASSWORD`, porque `deploy/postgres/inicializar-rol.sh`
# falla en voz alta antes de crear un rol sin contraseña.
DB_AUDITORIA_USERNAME=peluqueria
DB_AUDITORIA_PASSWORD=
DB_AUDITORIA_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis (caché, sesiones y colas)
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
# Minutos que dura una sesión abierta. En un salón conviene poco: el equipo se
# turna en el mismo puesto, y una sesión abierta mucho rato es una sesión
# abierta a la ficha de la clienta que vino antes.
SESSION_EXPIRACION_MINUTOS=120
# `true` en producción, con TLS válido en el dominio.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Authentik (identidad de Hefesto)
# -----------------------------------------------------------------------------
# URL pública del emisor, SIN barra final. El descubrimiento OIDC se lee de
# `<AUTHENTIK_ISSUER>/.well-known/openid-configuration`.
AUTHENTIK_ISSUER=
# Cliente OIDC EXCLUSIVO de esta aplicación: así se puede revocar el acceso a
# Peluquería sin tocar las demás aplicaciones de Hefesto.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Debe coincidir exactamente con la URL de retorno configurada en Authentik.
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTHENTIK_ALGORITMO=RS256
# Audiencia esperada del `id_token`. Si se deja vacía, se usa el identificador
# del cliente.
AUTHENTIK_AUDIENCE=
AUTHENTIK_LEEWAY=60
AUTHENTIK_CACHE_METADATA=60
AUTHENTIK_CACHE_JWKS=1440
# Prefijo del equipo de Authentik que declara el salón. El grupo completo es
# `salon-<identificador>`. Ver docs/05.
AUTHENTIK_GRUPO_POR_SALON=salon
# Los nombres de estos equipos son valores de configuración, no texto de
# pantalla: pueden llevar tilde, pero deben coincidir con Authentik.
AUTHENTIK_EQUIPO_RECEPCION="Recepción de Peluquería"
AUTHENTIK_EQUIPO_PROFESIONAL="Profesionales de Peluquería"
AUTHENTIK_EQUIPO_ADMINISTRADOR="Administradores de Peluquería"

# -----------------------------------------------------------------------------
# Agenda
# -----------------------------------------------------------------------------
# Red de seguridad para cuando el catálogo tiene un dato raro. La duración de
# una cita NO sale de acá: sale del servicio para esa profesional. Ver docs/02.
PELUQUERIA_DURACION_MAXIMA_MINUTOS=600
PELUQUERIA_ANTICIPACION_MAXIMA_DIAS=180

# -----------------------------------------------------------------------------
# Comisiones
# -----------------------------------------------------------------------------
# NO HAY PORCENTAJE POR OMISIÓN. La comisión la declara el salón en la tabla
# `politicas_comision`, y el cálculo falla si no hay ninguna vigente en vez de
# pagar cero. Ver docs/06.
#
# Días hacia atrás que se ofrecen como período por omisión en la pantalla. Es
# una ayuda de navegación, no una regla de negocio.
PELUQUERIA_PERIODO_COMISION_DIAS=15
# Volver a calcular una liquidación ya cerrada. En `false`, que es lo correcto:
# dos liquidaciones del mismo período acarrean dos cifras y el dueño no sabe
# cuál es la buena. Para corregir, se anula con motivo y se rehace.
PELUQUERIA_PERMITIR_RECALCULAR=false

# -----------------------------------------------------------------------------
# CONSERVACIÓN: ESTA DECISIÓN ES DEL CLIENTE, NO DEL SOFTWARE
# -----------------------------------------------------------------------------
# La Ley 19.628 obliga a que la conservación tenga una finalidad declarada, pero
# no se pudo verificar en este entorno el plazo que corresponde a una ficha de
# salón con antecedentes de salud. Por eso estas variables NACEN VACÍAS.
#
# Vacía significa: "no hay plazo configurado". La aplicación NO purga nada por su
# cuenta; borrar antecedentes de salud porque pasó un número inventado sería peor
# que no borrar nunca. Ver docs/07.
#
# COMPLETAR solo cuando el salón cliente, con su revisión legal, tenga un plazo
# escrito. El valor va en DÍAS.
PELUQUERIA_RETENCION_ANTECEDENTES_DIAS=
PELUQUERIA_RETENCION_BITACORA_DIAS=
PELUQUERIA_AVISAR_ANTES_DE_PURGAR=false

# -----------------------------------------------------------------------------
# QUÍMICA CAPILAR: PENDIENTE DE VERIFICACIÓN
# -----------------------------------------------------------------------------
# Es verdad que hay procesos que se repelen entre sí: un tinte y un retoque de
# color no se pueden hacer el mismo día sobre el mismo pelo.
#
# Lo que NO se pudo verificar en este entorno es cuántos días exige cada
# combinación, ni si el tiempo depende de la técnica o del fabricante. Por eso
# esta variable NACE VACÍA y la espera NO se comprueba.
#
# Poner un número aquí sería inventar un dato químico que puede dañar el pelo de
# una clienta real. Ver docs/02 y docs/06.
PELUQUERIA_DIAS_ENTRE_PROCESOS=