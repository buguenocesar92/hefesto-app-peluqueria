<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuracion de PHPUnit de Peluqueria.

    Las suites `Aislamiento`, `Agenda` y `Comisiones` estan separadas a
    proposito:

      - `Aislamiento`: un salon no puede leer los datos de otro. Usa Row Level
        Security de PostgreSQL.
      - `Agenda`: la cita se llena por TIEMPO DE SERVICIO, dos citas de la misma
        profesional no se solapan, y los bloqueos no se pisan.
      - `Comisiones`: el calculo devuelve el DESGLOSE y la liquidacion lo guarda,
        para que la cifra se pueda auditar linea por linea.

    Se pueden correr solas:
        php artisan test --testsuite=Aislamiento
        php artisan test --testsuite=Agenda
        php artisan test --testsuite=Comisiones
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Aislamiento">
            <directory>tests/Feature/Aislamiento</directory>
        </testsuite>
        <testsuite name="Agenda">
            <directory>tests/Feature/Agenda</directory>
        </testsuite>
        <testsuite name="Comisiones">
            <directory>tests/Feature/Comisiones</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
            IMPORTANTE: la base de pruebas TIENE que ser PostgreSQL, no SQLite.

            El aislamiento entre salones esta implementado con Row Level
            Security, que es una funcion de PostgreSQL. En SQLite estas pruebas
            pasarían sin comprobar nada: un sistema sin aislamiento alguno tambien
            daria verde, porque SQLite no tiene RLS que lo niegue.

            Esto ya se detecto en otro proyecto de Hefesto y se deja escrito para
            que no se repita. Ver docs/10.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="peluqueria_test"/>
    </php>
</phpunit>