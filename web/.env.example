# =============================================================================
# Peluquería: interfaz
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# =============================================================================

# -----------------------------------------------------------------------------
# Dirección interna de la API de Laravel, vista desde el servidor de Nuxt.
# -----------------------------------------------------------------------------
# Esta variable NUNCA sale hacia el navegador: vive en `runtimeConfig`, no en
# `runtimeConfig.public`.
NUXT_API_BASE=http://api:8000

# -----------------------------------------------------------------------------
# Días hacia atrás que se ofrecen como período por omisión en la pantalla de
# comisiones.
# -----------------------------------------------------------------------------
# Es una ayuda de navegación, no una regla de negocio. El período lo elige
# quien liquida.
NUXT_DIAS_COMISION=15

# -----------------------------------------------------------------------------
# Puerto en el que escucha Nuxt dentro del contenedor.
# -----------------------------------------------------------------------------
NITRO_PORT=3000

# -----------------------------------------------------------------------------
# NOTAS
# -----------------------------------------------------------------------------
# - No hay ninguna clave de API ni token de sesión en este archivo, y no debe
#   agregarse. La sesión es una cookie que viaja del navegador al servidor de
#   Nuxt y de ahí a la API: por eso el navegador no tiene ningún secreto.
# - En desarrollo, `NUXT_API_BASE` debe apuntar a la API tal como se ve desde tu
#   máquina (por ejemplo `http://localhost:8000`), no al nombre del contenedor.